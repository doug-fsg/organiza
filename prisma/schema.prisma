generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum UserRole {
  OWNER // Dono da conta
  ADMIN // Administrador
  MANAGER // Gerente
  MEMBER // Membro
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MainTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SubtaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  COMPLETED_PENDING
  APPROVED
  REJECTED
}

enum ActivityType {
  SUBTASK_CREATED
  SUBTASK_STARTED
  SUBTASK_PAUSED
  SUBTASK_RESUMED
  SUBTASK_COMPLETED
  SUBTASK_BLOCKED
  SUBTASK_UNBLOCKED
  SUBTASK_APPROVED
  SUBTASK_REJECTED
  SUBTASK_REASSIGNED
  DEPENDENCY_ADDED
  DEPENDENCY_REMOVED
  ESTIMATE_UPDATED
  COMMENT_ADDED
}

enum NotificationType {
  SUBTASK_ASSIGNED
  SUBTASK_COMPLETED
  SUBTASK_APPROVED
  SUBTASK_REJECTED
  SUBTASK_BLOCKED
  SUBTASK_UNBLOCKED
  SUBTASK_PENDING_APPROVAL
  SUBTASK_REASSIGNED
  GENERAL
}

enum RecurringType {
  DAILY
  WEEKLY
  BIWEEKLY // Quinzenal
  MONTHLY
  CUSTOM
}

enum WeekDay {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}

// ============================================
// MULTI-TENANT MODELS
// ============================================

model Account {
  id        String   @id @default(cuid())
  name      String // Nome da empresa/conta
  slug      String   @unique // URL amigável
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  accountUsers AccountUser[]
  mainTasks    MainTask[]

  @@map("accounts")
}

model AccountUser {
  id        String   @id @default(cuid())
  userId    String
  accountId String
  role      UserRole @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([userId, accountId])
  @@map("account_users")
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String // Hash da senha
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts         AccountUser[] // Contas do usuário
  createdTasks     MainTask[]     @relation("TaskCreator")
  assignedSubtasks Subtask[]      @relation("SubtaskAssignee")
  comments         Comment[]
  notifications    Notification[]
  activityLogs     ActivityLog[]

  @@map("users")
}

model MainTask {
  id          String         @id @default(cuid())
  title       String
  description String?
  status      MainTaskStatus @default(NOT_STARTED)
  priority    Priority       @default(MEDIUM)
  deadline    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  completedAt DateTime?
  createdBy   String
  accountId   String // Multi-tenant

  // Relations
  creator  User      @relation("TaskCreator", fields: [createdBy], references: [id])
  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  subtasks Subtask[]

  @@index([accountId])
  @@map("main_tasks")
}

model Subtask {
  id              String        @id @default(cuid())
  title           String
  description     String?
  status          SubtaskStatus @default(TODO)
  priority        Priority      @default(MEDIUM)
  deadline        DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  completedAt     DateTime?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  estimatedHours  Int?
  actualHours     Int?
  mainTaskId      String
  assignedToId    String?
  approvedBy      String?
  rejectedBy      String?
  rejectionReason String?

  // Approval settings
  requiresApproval Boolean @default(true)

  // Recurring task fields
  isRecurring         Boolean        @default(false)
  recurringType       RecurringType?
  recurringInterval   Int? // Para CUSTOM (a cada X dias)
  recurringWeekDays   String? // JSON array: ["MONDAY", "WEDNESDAY", "FRIDAY"]
  recurringMonthDays  String? // JSON array: [1, 15, 30]
  recurringEndDate    DateTime? // Quando a recorrência deve parar
  skipWeekends        Boolean        @default(false)
  skipHolidays        Boolean        @default(false)
  
  // Campos antigos (manter compatibilidade)
  recurringDay        Int? // DEPRECATED - usar recurringMonthDays
  recurringWeekDay    WeekDay? // DEPRECATED - usar recurringWeekDays
  lastReopenedAt      DateTime?
  nextReopenAt        DateTime?

  // Checklist
  checklistItems  String? // JSON array: [{ id, text, checked }]

  // Relations
  mainTask     MainTask            @relation(fields: [mainTaskId], references: [id], onDelete: Cascade)
  assignedTo   User?               @relation("SubtaskAssignee", fields: [assignedToId], references: [id])
  comments     Comment[]
  dependencies SubtaskDependency[] @relation("DependentSubtask")
  blocking     SubtaskDependency[] @relation("BlockingSubtask")
  activityLogs ActivityLog[]

  @@map("subtasks")
}

model SubtaskDependency {
  id          String   @id @default(cuid())
  dependentId String
  blockedById String
  createdAt   DateTime @default(now())

  // Relations
  dependent Subtask @relation("DependentSubtask", fields: [dependentId], references: [id], onDelete: Cascade)
  blocking  Subtask @relation("BlockingSubtask", fields: [blockedById], references: [id], onDelete: Cascade)

  @@unique([dependentId, blockedById])
  @@map("subtask_dependencies")
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subtaskId String
  authorId  String
  readBy    String?  // JSON array de user IDs que já leram

  // Relations
  subtask Subtask @relation(fields: [subtaskId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@map("comments")
}

model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  userId    String

  // Relations
  user User @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model ActivityLog {
  id          String       @id @default(cuid())
  type        ActivityType
  description String
  metadata    String? // JSON string for additional data
  createdAt   DateTime     @default(now())
  userId      String
  subtaskId   String?

  // Relations
  user    User     @relation(fields: [userId], references: [id])
  subtask Subtask? @relation(fields: [subtaskId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}

model UserInvite {
  id        String   @id @default(cuid())
  email     String
  name      String
  accountId String
  role      UserRole @default(MEMBER)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  createdBy String // ID do admin que criou o convite

  @@index([token])
  @@index([email])
  @@map("user_invites")
}
